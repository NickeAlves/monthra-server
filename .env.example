# Copy to .env (never committed) and replace every change-me value:
#   cp .env.example .env
# Docker Compose reads this file for variable interpolation and passes it to the api service.

# --- Service ---
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080
METRICS_ADDR=:9464
HTTP_MAX_BODY_BYTES=1048576
AUDIT_LOG_TTL=8760h

# --- Browser security ---
# Web app origins allowed to call the API from a browser (comma-separated, exact,
# no wildcards). List the app origin even when it is served from the API's origin.
# The app and the API must be on the same site (e.g. app.example.com + api.example.com):
# auth cookies are SameSite=Strict.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies whose X-Forwarded-For is trusted (CIDRs or addresses). Empty locally.
HTTP_TRUSTED_PROXIES=
# HMAC key of the CSRF tokens (base64, >= 32 bytes). Generate with: make secrets
CSRF_SECRET=change-me

# --- Rate limits (<n>/s, <n>/m or <n>/h) ---
RATE_LIMIT_API_IP=300/m
RATE_LIMIT_API_USER=100/m
# Register, login, email verification, password recovery and the MFA login
# step together, by IP and by target email.
RATE_LIMIT_AUTH_IP=5/m
RATE_LIMIT_AUTH_EMAIL=5/m
RATE_LIMIT_REFRESH_IP=30/m
# Account emails (verification, sign-up attempt, password reset) sent to one address.
RATE_LIMIT_AUTH_MAIL=5/h

# --- Authentication ---
# Ed25519 seeds (32 bytes, base64) that sign access tokens, as kid:key pairs.
# To rotate: add a new pair, point JWT_ACTIVE_KID at it, and drop the old pair
# once ACCESS_TOKEN_TTL has passed. Generate with: make secrets
JWT_SIGNING_KEYS=change-me
JWT_ACTIVE_KID=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# A refresh token reused this soon after its rotation answers 409 (two tabs
# refreshing at once) instead of revoking the session as a stolen token.
REFRESH_REUSE_GRACE=10s
EMAIL_TOKEN_TTL=30m
# Lifetime of password reset links (5 to 30 minutes).
RESET_TOKEN_TTL=15m
# Parallel Argon2id hashes (64 MiB each).
PASSWORD_HASH_CONCURRENCY=4
# Reject passwords found in Have I Been Pwned (only a 5-character hash prefix leaves the server).
HIBP_ENABLED=true
# Web app base URL used in email links (https outside local).
APP_PUBLIC_URL=http://localhost:3000
# Cloudflare Turnstile secret. Empty disables the captcha after repeated failures.
TURNSTILE_SECRET=

# --- Encryption at rest ---
# AES-256 keys (32 bytes, base64) as kid:key pairs; they encrypt TOTP secrets.
# To rotate: add a new pair and point ENCRYPTION_ACTIVE_KID at it. Keep the old
# pair: values sealed with it are re-encrypted when used, never all at once.
# Never reuse CSRF_SECRET or a JWT key. Generate with: make secrets
ENCRYPTION_KEYS=change-me
ENCRYPTION_ACTIVE_KID=change-me

# --- Email (SMTP) ---
# Locally the API sends to Mailpit (UI on http://localhost:8025); `make run` swaps the host for localhost.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Monthra <no-reply@monthra.local>"
# none (local only), starttls (port 587) or tls (port 465).
SMTP_TLS=none

# --- MongoDB ---
MONGO_DATABASE=monthra
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
# Least-privilege user the API connects with (created on first start by deploy/mongo/init-app-user.js).
MONGO_APP_USERNAME=monthra
MONGO_APP_PASSWORD=change-me
# Inside compose the host is "mongo"; `make run` swaps it for localhost.
MONGO_URI=mongodb://monthra:change-me@mongo:27017/monthra?authSource=monthra

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# --- mongo-express (only with: docker compose --profile tools up) ---
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

# --- Tracing (empty disables export; the monthra-infra collector listens on 4318) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- make seed (local only): the demo user demo@monthra.local; empty makes up a password and prints it ---
SEED_PASSWORD=
