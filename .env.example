# Copy to .env (never committed) and replace every change-me value:
#   cp .env.example .env
# Docker Compose reads this file for variable interpolation and passes it to the api service.

# --- Service ---
APP_ENV=local
LOG_LEVEL=debug
HTTP_ADDR=:8080
METRICS_ADDR=:9464
HTTP_MAX_BODY_BYTES=1048576
AUDIT_LOG_TTL=8760h

# --- MongoDB ---
MONGO_DATABASE=monthra
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
# Least-privilege user the API connects with (created on first start by deploy/mongo/init-app-user.js).
MONGO_APP_USERNAME=monthra
MONGO_APP_PASSWORD=change-me
# Inside compose the host is "mongo"; `make run` swaps it for localhost.
MONGO_URI=mongodb://monthra:change-me@mongo:27017/monthra?authSource=monthra

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# --- mongo-express (only with: docker compose --profile tools up) ---
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

# --- Tracing (empty disables export; the monthra-infra collector listens on 4318) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
